# Quasi-static sphere-sphere overlap sweep
# One particle pair, zero velocity. MODEL selects hooke or hertz.
units           si
atom_style      sphere
boundary        f f f
comm_modify     vel yes
atom_modify     map array
newton          on

region          box block -0.02 0.04 -0.02 0.02 -0.02 0.02
create_box      1 box
Created orthogonal box = (-0.02 -0.02 -0.02) to (0.04 0.02 0.02)
  1 by 1 by 1 MPI processor grid

variable        model string hooke
pair_style      granular
pair_coeff      * * hertz/material 7.000000000000e+10 0.0 0.22 tangential linear_nohistory 0.0 0.0 damping velocity

neighbor        0.002 bin
neigh_modify    delay 0 every 1 check yes

create_atoms    1 single 0.0 0.0 0.0
Created 1 atoms
  using lattice units in orthogonal box = (-0.02 -0.02 -0.02) to (0.04 0.02 0.02)
  create_atoms CPU = 0.000 seconds
create_atoms    1 single 0.009999 0.0 0.0
Created 1 atoms
  using lattice units in orthogonal box = (-0.02 -0.02 -0.02) to (0.04 0.02 0.02)
  create_atoms CPU = 0.000 seconds
set             atom 1*2 diameter 1.000000000000e-02
Setting atom values ...
  2 settings made for diameter
set             atom 1*2 density 2500.0
Setting atom values ...
  2 settings made for density
set             atom * vx 0.0 vy 0.0 vz 0.0
Setting atom values ...
  2 settings made for vx
  2 settings made for vy
  2 settings made for vz

variable        i loop 20
variable        delta equal v_i*1.0e-7
variable        xpos equal 0.01-v_delta
variable        fx1 equal fx[1]
variable        x1 equal x[1]
variable        x2a equal x[2]

thermo          1
thermo_style    custom step pe fmax

label           loop
reset_timestep  $i
reset_timestep  1
set             atom 1 x 0.0 y 0.0 z 0.0 vx 0.0 vy 0.0 vz 0.0
Setting atom values ...
  1 settings made for x
  1 settings made for y
  1 settings made for z
  1 settings made for vx
  1 settings made for vy
  1 settings made for vz
