# Head-on sphere-sphere collision with the linear spring-dashpot law
units           si
atom_style      sphere
boundary        f f f
comm_modify     vel yes
atom_modify     map array
newton          on

region          box block -0.05 0.06 -0.02 0.02 -0.02 0.02
create_box      1 box

pair_style      granular
pair_coeff      * * hooke 5.201500071780e+06 3.911402719745e+00 tangential linear_nohistory 0.0 0.0 damping velocity

neighbor        0.005 bin
neigh_modify    delay 0 every 1 check yes

# Initial gap of 2 um so contact begins after the neighbour list is active.
create_atoms    1 single 0.0 0.0 0.0
create_atoms    1 single 0.010002 0.0 0.0
set             atom 1*2 diameter 1.000000000000e-02
set             atom 1*2 density 2500.0
set             atom 1 vx  9.391709114819e-02 vy 0.0 vz 0.0
set             atom 2 vx -9.391709114819e-02 vy 0.0 vz 0.0

fix             1 all nve/sphere
timestep        1.0e-7

dump            1 all custom 1 ../data/collision.dump id x vx fx radius
dump_modify     1 sort id format float %.16e

thermo_style    custom step ke pe etotal
thermo          50
run             1000
